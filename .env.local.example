# ULIKA — environment template.
#
# Copy to .env.local and fill in. THIS FILE IS COMMITTED: it carries variable
# NAMES and empty values only. Never paste a real key, URL or project ref here.
# Real values belong in .env.local, which .gitignore still excludes.

# ---------------------------------------------------------------- environment
#
# NOT YET IN EFFECT. The two variables in this section are read by
# scripts/_env-guard.ts, and no tool calls that guard yet: ingest-knowledge,
# ingest-scenarios and register-source still run without them. Fill them in
# anyway — wiring the guard is the next commit, and it will start refusing.
# Until then nothing in this section protects anything.
#
# Note for when it does land: `npx tsx scripts/...` does NOT load .env.local by
# itself the way `next dev` does. The wiring commit has to load it explicitly,
# or the guard will see missing variables on a machine where this file is
# filled in correctly.

# Which environment this shell is pointed at: local | staging | production.
#
# This is your CLAIM, and it is not trusted on its own — it sits in the same
# file as the credentials, so a copied or stale .env.local can say staging while
# pointing at production, and be perfectly self-consistent while doing it. The
# guard checks it against scripts/_environments.ts, which lives in the
# repository and cannot be edited in the course of fixing your local setup.
#
# Once the guard is wired: writes (corpus ingest, admin bootstrap) require BOTH
# staging here AND the project listed as staging there. Today that list is
# empty, so no project may be written to at all.
ULIKA_ENV=

# The Supabase project ref this shell is allowed to touch — the 20-character
# slug in front of .supabase.co, e.g. the "abcdefghijklmnopqrst" in
# https://abcdefghijklmnopqrst.supabase.co
#
# Once wired, the guard will extract the ref from NEXT_PUBLIC_SUPABASE_URL and
# refuse to issue a single query unless the two match exactly — and separately
# refuse if scripts/_environments.ts records that ref as a different environment
# than ULIKA_ENV claims. It exists because there is one hand-edited .env.local,
# one service-role key that bypasses RLS, and therefore nothing else standing
# between a stale shell and the live corpus.
#
# A project ref is not a secret (it is in every request URL the browser makes),
# but leave it empty here anyway — the point of the check is that each operator
# states it deliberately for their own machine.
EXPECTED_SUPABASE_PROJECT_REF=

# ------------------------------------------------------------------- supabase

# Required for auth, saved plans, the Mentalist's memory, knowledge retrieval
# (the pgvector RPC) and the interaction event log. Leave both unset to run in
# guest mode: chat and the training catalogue still work, nothing persists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-SIDE SEED AND ADMIN TOOLS ONLY — scripts/ run by hand with tsx.
#
# This key BYPASSES ROW LEVEL SECURITY completely. Three rules, and the status
# of each is stated exactly, because a rule believed to be enforced when it is
# not is worse than one known to be manual:
#   1. it must never end up in a NEXT_PUBLIC_ variable — that prefix is what
#      Next.js inlines into the browser bundle, so a service-role key under any
#      such name is published to every visitor. scripts/_env-guard.ts refuses
#      outright before any other check, matching on the VALUE (equality with
#      this key, an sb_secret_ prefix, or a JWT carrying role=service_role) and
#      not just on the variable name. ENFORCED ONLY ONCE THE GUARD IS WIRED —
#      today nothing calls it;
#   2. it must never be referenced by anything under src/. ENFORCED NOW: a test
#      in the standard `npm test` run fails if src/ mentions it at all;
#   3. it is not needed to run the app. `npm run dev` and the deployed site use
#      the anon key and RLS. This one is a fact, not a check.
SUPABASE_SERVICE_ROLE_KEY_ULIKA=

# ------------------------------------------------------------------------- ai

# Required for /chat, the crisis detector, the knowledge router, and for
# generating embeddings during corpus ingest. Without it the site still runs:
# /chat says plainly that AI is not configured rather than erroring.
OPENROUTER_API_KEY=

# Optional model override. Recognised values: grok | gemini.
# Unset uses the default, anthropic/claude-sonnet-5 via OpenRouter.
# Anything unrecognised is ignored and falls through to the default, so a typo
# here fails quietly — check src/lib/ai/provider.ts if the model is not what
# you expected.
# AI_PROVIDER=
